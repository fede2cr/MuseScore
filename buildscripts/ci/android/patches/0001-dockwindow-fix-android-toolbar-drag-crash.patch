+    if (m_inEventFilter) {
+        // Re-entrancy guard. On some platforms (notably Android) starting a drag creates and
+        // shows the floating window (Draggable::makeWindow -> DockWidget::setFloating), which
+        // synchronously flushes the window-system event queue. That re-delivers touch/mouse
+        // events into this filter while the drag state machine is still mid-transition.
+        // Dispatching them to the state machine here corrupts its state and crashes, so let
+        // such nested events propagate normally instead of feeding them back into the drag.
+        return false;
